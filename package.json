{
  "name": "penfight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Flick your pen, knock everyone else off the table. Last pen standing wins.",
  "scripts": {
    "dev": "vite",
    "dev:server": "wrangler dev --port 8787",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "wrangler": "^4.119.0"
  }
}
